# Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_REQUIRED=false
SECRET_KEY=your_secure_random_secret_key_minimum_16_characters

# Local PostgreSQL Credentials & Configuration (Required)
POSTGRES_USER=genius
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=genius_ai
POSTGRES_TEST_USER=genius_test
POSTGRES_TEST_PASSWORD=your_secure_postgres_test_password_here
POSTGRES_TEST_DB=genius_ai_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional Database URL override (if omitted, safely constructed from POSTGRES_* settings above)
# DATABASE_URL=postgresql+asyncpg://genius:your_secure_postgres_password_here@localhost:5433/genius_ai
# DATABASE_URL_TEST=postgresql+asyncpg://genius_test:your_secure_postgres_test_password_here@localhost:5433/genius_ai_test
# DATABASE_URL_DOCKER=postgresql+asyncpg://genius:your_secure_postgres_password_here@postgres:5432/genius_ai


# External AI API Keys (Optional fallbacks for cloud model integrations)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Local Ollama (Offline AI Inference)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_ITERATIONS=5

# Local Speech-to-Text (faster-whisper)
STT_BACKEND=faster-whisper
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MAX_UPLOAD_BYTES=10485760
STT_MAX_DURATION_SECONDS=120

# IPL ML Model Artifact
IPL_MODEL_PATH=pipe.pkl

# Frontend Web Client
VITE_API_URL=http://127.0.0.1:8000