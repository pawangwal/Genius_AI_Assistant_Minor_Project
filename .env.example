# Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Security & CORS
CORS_ORIGINS=http://localhost:5173
AUTH_REQUIRED=false
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://genius:genius_password@localhost:5432/genius_ai

# Local Ollama (Offline AI Inference)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_ITERATIONS=5

# Local Speech-to-Text (faster-whisper)
STT_BACKEND=faster-whisper
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MAX_UPLOAD_BYTES=10485760
STT_MAX_DURATION_SECONDS=120

# IPL ML Model Artifact
IPL_MODEL_PATH=pipe.pkl